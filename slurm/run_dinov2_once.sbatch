#!/usr/bin/env bash
#SBATCH --job-name=plm-dino-pilot
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=8g
#SBATCH --time=00:10:00
#SBATCH --no-requeue

set -euo pipefail
umask 077

: "${SLURM_JOB_ID:?This wrapper must run inside an allocation}"
if [ -n "${SLURM_ARRAY_JOB_ID:-}" ]; then
  echo "STOP: arrays are not allowed for this first pilot."
  exit 1
fi
if [ "${2:-}" != "I_AUTHORIZE_ONE_DINOV2_PILOT" ]; then
  echo "STOP: explicit operator authorization is required."
  exit 1
fi
SESSION="${1:?Supply the private launch.env.sh generated by prepare_native_launch.py}"
test -f "$SESSION"
source "$SESSION"
: "${PILOT_EXPECTED_SHA:?Missing pinned source}"
: "${PILOT_BINDINGS:?Missing immutable-file bindings}"
: "${PILOT_CODE:?Missing source checkout}"
: "${PILOT_ENV:?Missing environment}"
: "${PILOT_DATA:?Missing approved input root}"
: "${PILOT_OUT:?Missing new output directory}"

test ! -e "$PILOT_OUT"
test ! -L "$PILOT_OUT"
test ! -e "$PILOT_OUT.working"
test ! -L "$PILOT_OUT.working"
test "$(git -C "$PILOT_CODE" rev-parse HEAD)" = "$PILOT_EXPECTED_SHA"
test -z "$(git -C "$PILOT_CODE" status --porcelain)"

module load python/3.11
unset PYTHONHOME
export PYTHONPATH="$PILOT_CODE/src"
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2

"$PILOT_ENV/bin/python" - "$PILOT_BINDINGS" "$PILOT_MANIFEST" <<'PY'
import hashlib
import json
import sys
from pathlib import Path

for filename, expected in json.loads(Path(sys.argv[1]).read_text()).items():
    h = hashlib.sha256()
    with Path(filename).open('rb') as f:
        for b in iter(lambda: f.read(1024 * 1024), b''):
            h.update(b)
    if h.hexdigest() != expected:
        raise SystemExit('STOP: a file changed after launch preparation')
manifest = json.loads(Path(sys.argv[2]).read_text())
if manifest.get('model') != 'dinov2' or manifest.get('execution') != 'approved_inference':
    raise SystemExit('STOP: not an approved DINOv2 inference request')
if type(manifest.get('max_inputs')) is not int or not 1 <= manifest['max_inputs'] <= 8:
    raise SystemExit('STOP: invalid first-pilot bound')
print('Prelaunch file bindings match. The native worker will validate approvals and assets.')
PY

# Reuse the repository implementation; do not duplicate its model-loading logic.
# The native shell checks the relative approval before changing to PILOT_CODE.
cd "$PILOT_DATA"
bash "$PILOT_CODE/slurm/phase4_pilot.sbatch"
echo "Native worker returned exit code 0. Review its completion artifact and checksums."
